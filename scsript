-- Функция для подсветки
local function highlight(obj)
    if not obj:FindFirstChild("AnomalyHighlight") then
        local h = Instance.new("Highlight")
        h.Name = "AnomalyHighlight"
        h.FillColor = Color3.fromRGB(255, 0, 0)
        h.OutlineColor = Color3.fromRGB(255, 255, 255)
        h.FillTransparency = 0.5
        h.Parent = obj
    end
end

-- Функция поиска текущего сегмента игрока
local function GetCurrentSegment()
    local charPos = Character.PrimaryPart.Position
    local closest = nil
    local minDist = math.huge

    for _, seg in pairs(MapSegments:GetChildren()) do
        if seg:IsA("Model") then
            local dist = (seg:GetModelCFrame().Position - charPos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = seg
            end
        end
    end
    return closest
end

-- Основной цикл

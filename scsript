-- ── Снапшоты ───────────────────────────────────────────────────

-- Снапшот BasePart: цвет + вращение
local function snapPart(part)
    if not part:IsA("BasePart") then return nil end
    return { Color = part.Color, Orientation = part.Orientation }
end

local function partColorChanged(part, snap)
    return snap ~= nil and part.Color ~= snap.Color
end

local function partRotationChanged(part, snap)
    if not snap then return false end
    local o, r = part.Orientation, snap.Orientation
    return math.abs(o.X - r.X) > ROT_EPS
        or math.abs(o.Y - r.Y) > ROT_EPS
        or math.abs(o.Z - r.Z) > ROT_EPS
end

local function partSizeChanged(part, normalSize)
    local s = part.Size
    return math.abs(s.X - normalSize.X) > SIZE_EPS
        or math.abs(s.Y - normalSize.Y) > SIZE_EPS
        or math.abs(s.Z - normalSize.Z) > SIZE_EPS
end

-- Снапшот всей модели: цвета всех BasePart-потомков + количество
local function snapModel(model)
    local s = { _count = 0 }
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            s._count  += 1
            s[d.Name]  = d.Color
        end
    end
    return s
end

local function modelChanged(model, snap)
    if not snap then return false end
    local count = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            count += 1
            if snap[d.Name] and d.Color ~= snap[d.Name] then return true end
        end
    end
    return count ~= snap._count
end

-- Снапшот внешности NPC John
-- Проверяем: цвета частей тела, Shirt, Pants, кол-во Accessory
local function snapNPCAppearance(john)
    local s = {
        bodyColors  = {},
        shirt       = "",
        pants       = "",
        accessories = {},
    }
    -- Цвета прямых BasePart-детей (голова, торс, руки, ноги)
    for _, part in ipairs(john:GetChildren()) do
        if part:IsA("BasePart") then
            s.bodyColors[part.Name] = part.Color
        end
    end
    -- Рубашка / штаны
    local shirt = john:FindFirstChildOfClass("Shirt")
    local pants  = john:FindFirstChildOfClass("Pants")
    if shirt then s.shirt = shirt.ShirtTemplate end
    if pants  then s.pants = pants.PantsTemplate  end
    -- Количество аксессуаров и их имена
    for _, child in ipairs(john:GetChildren()) do
        if child:IsA("Accessory") then
            s.accessories[child.Name] = true
        end
    end
    return s
end

-- Возвращает первую изменившуюся часть тела (для подсветки) или nil
local function npcAppearanceChanged(john, snap)
    if not snap then return nil end

    -- Цвета тела
    for _, part in ipairs(john:GetChildren()) do
        if part:IsA("BasePart") then
            local refColor = snap.bodyColors[part.Name]
            if refColor and part.Color ~= refColor then
                return part  -- подсвечиваем конкретную часть
            end
        end
    end

    -- Рубашка
    local shirt = john:FindFirstChildOfClass("Shirt")
    local curShirt = shirt and shirt.ShirtTemplate or ""
    if curShirt ~= snap.shirt then
        -- Подсвечиваем торс (или Head если торса нет)
        return john:FindFirstChild("Torso")
            or john:FindFirstChild("UpperTorso")
            or john:FindFirstChild("Head")
    end

    -- Штаны
    local pants = john:FindFirstChildOfClass("Pants")
    local curPants = pants and pants.PantsTemplate or ""
    if curPants ~= snap.pants then
        return john:FindFirstChild("Torso")
            or john:FindFirstChild("LowerTorso")
            or john:FindFirstChild("Head")
    end

    -- Аксессуары: появился новый
    for _, child in ipairs(john:GetChildren()) do
        if child:IsA("Accessory") and not snap.accessories[child.Name] then
            return child
        end
    end

    return nil
end

-- ── Сборка всех снапшотов из Segment000 ───────────────────────

local refPartSnaps  = {}  -- [partName] = snap
local refCaseSnap   = nil
local refFaceSnap   = nil -- { Texture }
local refNPCSnap    = nil -- внешность John

local function buildSnapshots()
    -- Наблюдаемые парты (цвет + вращение)
    local watchAll = {}
    for _, n in ipairs(WATCH_PART_NAMES) do watchAll[n] = true end
    for _, n in ipairs(WATCH_ROTATION)   do watchAll[n] = true end

    for name in pairs(watchAll) do
        local p = reference:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then
            refPartSnaps[name] = snapPart(p)
        end
    end

    -- John: Case, face, внешность
    local debris = reference:FindFirstChild("Debris")
    if debris then
        local john = debris:FindFirstChild("John")
        if john then
            -- Case
            local case = john:FindFirstChild("Case")
            if case then refCaseSnap = snapModel(case) end
            -- Face декаль
            local head = john:FindFirstChild("Head")
            if head then
                local face = head:FindFirstChild("face")
                          or head:FindFirstChildOfClass("Decal")
                if face and face:IsA("Decal") then
                    refFaceSnap = { Texture = face.Texture }
                end
            end
            -- Внешность (костюм, цвет тела)
            refNPCSnap = snapNPCAppearance(john)
        end
    end
end

buildSnapshots()

-- Запоминаем детей spawn-папок из Segment000, чтобы не считать их аномалией
-- (в 000 PuddleSpawn уже содержит Part1-Part5, ShadowSpawn — Part1-Part2)
local refSpawnChildren = {}   -- refSpawnChildren["PuddleSpawn"] = { Part1=true, ... }
do
    local refRefs = reference:FindFirstChild("References")
    if refRefs then
        for _, fn in ipairs(SPAWN_FOLDERS) do
            refSpawnChildren[fn] = {}
            local folder = refRefs:FindFirstChild(fn)
            if folder then
                for _, c in ipairs(folder:GetChildren()) do
                    refSpawnChildren[fn][c.Name] = true
                end
            end
        end
    end
end


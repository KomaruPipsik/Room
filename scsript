local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local UserInputService  = game:GetService("UserInputService")

local player      = Players.LocalPlayer
local SCAN_RATE   = 1.5
local HL_COLOR    = Color3.fromRGB(255, 40, 40)
local ROT_EPS     = 1.0
local SIZE_EPS    = 0.05
local POS_EPS     = 0.5

local mapSegments = workspace:WaitForChild("MapSegments", 15)
if not mapSegments then warn("[AD] MapSegments not found") return end

local reference = mapSegments:WaitForChild("Segment000", 15)
if not reference then warn("[AD] Segment000 not found") return end

local WATCHED_OBJECTS = {
    "BrokenLight","CeilingExitSign","Door1","Door2",
    "FlowersSign","Frame1","Frame2","Frame3","Frame4",
    "TrashSign","WallExitSign"
}

local EXTRA_OBJECTS = {
    "Door3","EyeClock","ExtraCamera1","ExtraCamera2",
    "ArrowSign2","BloodPart","WallDestroyEffect"
}

local DANGER_REFS = {
    "SCP096","Stalker","Fog","AnomalyDoor",
    "Monster","Entity","Shadow","Creature"
}

local JOHN_FACE      = "rbxassetid://622196409"
local JOHN_COLOR     = Color3.fromRGB(27, 42, 53)
local TRASH_COLOR    = Color3.fromRGB(99, 95, 98)
local CAM_FRAME_SIZE = Vector3.new(0.262, 2.799, 3.416)

local function colorEq(a, b)
    return math.abs(a.R-b.R)<0.01 and math.abs(a.G-b.G)<0.01 and math.abs(a.B-b.B)<0.01
end
local function sizeEq(a, b)
    return math.abs(a.X-b.X)<=SIZE_EPS and math.abs(a.Y-b.Y)<=SIZE_EPS and math.abs(a.Z-b.Z)<=SIZE_EPS
end
local function rotEq(a, b)
    return math.abs(a.X-b.X)<=ROT_EPS and math.abs(a.Y-b.Y)<=ROT_EPS and math.abs(a.Z-b.Z)<=ROT_EPS
end
local function deepFind(parent, name)
    return parent:FindFirstChild(name) or parent:FindFirstChild(name, true)
end
local function firstPart(obj)
    if obj:IsA("BasePart") then return obj end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    return nil
end

local refSnap = {}

local function buildRefSnap()
    local objFolder = reference:FindFirstChild("Objects")
    if objFolder then
        for _, name in ipairs(WATCHED_OBJECTS) do
            local obj = deepFind(objFolder, name)
            if obj then
                local entry = { exists = true }
                local part = firstPart(obj)
                if part then
                    entry.Color       = part.Color
                    entry.Size        = part.Size
                    entry.Orientation = part.Orientation
                    entry.Position    = part.Position
                end
                refSnap.objects = refSnap.objects or {}
                refSnap.objects[name] = entry
            end
        end

        local arrow = deepFind(objFolder, "ArrowSign")
        if arrow then
            local p = firstPart(arrow)
            if p then refSnap.arrowOri = p.Orientation end
        end

        local trashBin = deepFind(objFolder, "TrashBin") or deepFind(reference, "TrashBin")
        if trashBin then
            local p = firstPart(trashBin)
            if p then refSnap.trashPos = p.Position end
        else
            refSnap.trashMissing = true
        end
    end

    refSnap.vents = {}
    for _, vname in ipairs({"Vent1","Vent2","Vent1Hidden"}) do
        refSnap.vents[vname] = deepFind(reference, vname) ~= nil
    end
end

buildRefSnap()

local xrayOn        = false
local hlOn          = true
local mouseUnlocked = false

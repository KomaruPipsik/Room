-- ── Утилиты ────────────────────────────────────────────────────

local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and not IGNORE_SEGMENTS[seg.Name] then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestD then best, bestD = seg, d end
        end
    end
    return best
end

-- Подсветка: находим подходящий объект для Highlight.
-- Highlight работает только с BasePart и Model.
-- Если объект другого типа (Folder, Script...) — ищем BasePart среди потомков,
-- или поднимаемся к предку-Model/BasePart.
local function findHighlightTarget(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then return obj end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    local p = obj.Parent
    while p and p ~= mapSegments do
        if p:IsA("BasePart") or p:IsA("Model") then return p end
        p = p.Parent
    end
    return nil
end

local function addHighlight(obj)
    local target = findHighlightTarget(obj)
    if not target then return end
    -- Пропускаем полностью прозрачные BasePart-ы
    if target:IsA("BasePart") and target.Transparency >= 1 then return end
    -- Для Model — пропускаем если все части прозрачны
    if target:IsA("Model") then
        local hasVisible = false
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 then
                hasVisible = true
                break
            end
        end
        if not hasVisible then return end
    end
    if target:FindFirstChildOfClass("Highlight") then return end
    local h              = Instance.new("Highlight")
    h.FillColor          = HIGHLIGHT_COLOR
    h.OutlineColor       = HIGHLIGHT_COLOR
    h.FillTransparency   = 0.55
    h.OutlineTransparency= 0
    h.Adornee            = target
    h.Parent             = target
end

local function clearHighlights(seg)
    for _, h in ipairs(seg:GetDescendants()) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- ── Сканирование ───────────────────────────────────────────────

local function scanSeg(seg)
    local flagged = {}   -- объекты для подсветки
    local missing = {}   -- имена пропавших обязательных объектов

    -- ① Глубокий поиск: объекты из чёрного списка
    --    (NPC John и AnomalyCounter пропускаем)
    for _, obj in ipairs(seg:GetDescendants()) do
        local n = obj.Name
        if n ~= "John" and n ~= "AnomalyCounter" then
            if ANOMALY_ON_APPEAR[n] then
                table.insert(flagged, obj)
            end
        end
    end

    -- ② Spawn-папки: дети, которых не было в Segment000 = аномалия
    local refs = seg:FindFirstChild("References")
    if refs then
        for _, fn in ipairs(SPAWN_FOLDERS) do
            local folder = refs:FindFirstChild(fn)
            if folder then
                local refChildren = refSpawnChildren[fn] or {}
                for _, child in ipairs(folder:GetChildren()) do
                    if not refChildren[child.Name] then
                        table.insert(flagged, child)
                    end
                end
            end
        end
    end

    -- ③ Обязательные объекты: отсутствие = аномалия
    for _, name in ipairs(REQUIRED_OBJECTS) do
        if not seg:FindFirstChild(name, true) then
            table.insert(missing, name)
        end
    end

    -- ④ Наблюдаемые парты: изменение ЦВЕТА = аномалия
    for _, name in ipairs(WATCH_PART_NAMES) do
        local snap = refPartSnaps[name]
        if snap then
            local part = seg:FindFirstChild(name, true)
            if part and part:IsA("BasePart") and partColorChanged(part, snap) then
                table.insert(flagged, part)
            end
        end
    end

    -- ⑤ Изменение ВРАЩЕНИЯ = аномалия
    for _, name in ipairs(WATCH_ROTATION) do
        local snap = refPartSnaps[name]
        if snap then
            local part = seg:FindFirstChild(name, true)
            if part and part:IsA("BasePart") and partRotationChanged(part, snap) then
                table.insert(flagged, part)
            end
        end
    end

    -- ⑥ Изменение РАЗМЕРА = аномалия
    for _, entry in ipairs(WATCH_SIZE) do
        local part = seg:FindFirstChild(entry.name, true)
        if part and part:IsA("BasePart") and partSizeChanged(part, entry.size) then
            table.insert(flagged, part)
        end
    end

    -- ⑦ John → Case / Face / костюм
    local debris = seg:FindFirstChild("Debris")
    if debris then
        local john = debris:FindFirstChild("John")
        if john then

            -- Case
            if refCaseSnap then
                local case = john:FindFirstChild("Case")
                if case and modelChanged(case, refCaseSnap) then
                    table.insert(flagged, case)
                end
            end

            -- Face декаль
            if refFaceSnap then
                local head = john:FindFirstChild("Head")
                if head then
                    local face = head:FindFirstChild("face")
                              or head:FindFirstChildOfClass("Decal")
                    if face and face:IsA("Decal")
                    and face.Texture ~= refFaceSnap.Texture then
                        table.insert(flagged, head)
                    end
                end
            end

            -- Костюм / цвет тела
            if refNPCSnap then
                local changedPart = npcAppearanceChanged(john, refNPCSnap)
                if changedPart then
                    table.insert(flagged, changedPart)
                end
            end

        end
    end

    return flagged, missing
end

-- ── Главный цикл ───────────────────────────────────────────────

local lastSeg      = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_INTERVAL then return end
    lastScanTime = now

    local seg = getNearestSeg()

    if not seg then
        segLabel.Text = "Сегмент: не найден"
        cntLabel.Text = "Аномалий: —"
        misLabel.Text = ""
        return
    end

    -- Сбросить подсветку в старом сегменте при смене зоны
    if lastSeg and lastSeg ~= seg then
        clearHighlights(lastSeg)
    end
    lastSeg = seg

    segLabel.Text = "Сегмент: " .. seg.Name

    -- Segment000 — эталон, сканировать не нужно
    if seg == reference then
        clearHighlights(seg)
        cntLabel.Text       = "Аномалий: 0"
        cntLabel.TextColor3 = Color3.fromRGB(90, 215, 90)
        misLabel.Text       = ""
        return
    end

    local anomObjs, missList = scanSeg(seg)

    -- Перерисовать подсветку
    clearHighlights(seg)
    for _, obj in ipairs(anomObjs) do
        addHighlight(obj)
    end

    -- Обновить GUI
    local total = #anomObjs + #missList
    cntLabel.Text      = "Аномалий: " .. total
    cntLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)

    misLabel.Text = #missList > 0
        and ("Нет: " .. table.concat(missList, ", "))
        or  ""
end)

print("[AnomalyDetector v3fix3] Запущен. Интервал:", SCAN_INTERVAL, "сек.")

-- Настройки
local MapSegments = workspace:WaitForChild("MapSegments")
local Player = game.Players.LocalPlayer

-- Создание Мини-Меню (ScreenGui)
local gui = Instance.new("ScreenGui")
gui.Name = "AnomalyDetectorGui"
gui.Parent = Player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 80)
frame.Position = UDim2.new(0, 20, 0, 20)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
frame.BorderSizePixel = 2
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "Детектор Аномалий"
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundTransparency = 1
title.Parent = frame

local counterLabel = Instance.new("TextLabel")
counterLabel.Size = UDim2.new(1, 0, 0, 50)
counterLabel.Position = UDim2.new(0, 0, 0, 30)
counterLabel.Text = "Аномалий: 0"
counterLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
counterLabel.TextSize = 20
counterLabel.BackgroundTransparency = 1
counterLabel.Parent = frame

-- Функция для глубокого подсчета детей (включая все вложенные папки)
local function countAllDescendants(parent)
    return #parent:GetDescendants()
end

-- Основная логика сравнения
local function checkAnomalies()
    local reference = MapSegments:FindFirstChild("Segment000")
    if not reference then return end

    local currentAnomalies = 0
    
    -- Получаем все сегменты, кроме эталонного
    for _, segment in pairs(MapSegments:GetChildren()) do
        if segment.Name ~= "Segment000" then
            
            -- 1. Сравнение общего количества объектов
            local refCount = countAllDescendants(reference)
            local curCount = countAllDescendants(segment)
            
            if curCount ~= refCount then
                currentAnomalies = currentAnomalies + math.abs(curCount - refCount)
            end

            -- 2. Проверка специфических объектов, которые ты указал
            -- Сравниваем папку References (PuddleSpawn, ShadowSpawn и т.д.)
            local refRefs = reference:FindFirstChild("References")
            local curRefs = segment:FindFirstChild("References")
            
            if refRefs and curRefs then
                if countAllDescendants(curRefs) > countAllDescendants(refRefs) then
                    currentAnomalies = currentAnomalies + 1
                end
            end

            -- 3. Проверка лишних камер
            if segment:FindFirstChild("ExtraCamera1", true) or segment:FindFirstChild("ExtraCamera2", true) then
                currentAnomalies = currentAnomalies + 1
            end
        end
    end

    -- Обновление текста в меню
    counterLabel.Text = "Аномалий: " .. tostring(currentAnomalies)
    
    -- Визуальный сигнал: если аномалий > 0, рамка светится красным
    if currentAnomalies > 0 then
        frame.BorderColor3 = Color3.new(1, 0, 0)
    else
        frame.BorderColor3 = Color3.new(0, 1, 0)
    end
end

-- Цикл проверки
print("Система сравнения сегментов запущена...")
while task.wait(2) do
    checkAnomalies()
end

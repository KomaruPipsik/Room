local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- ┌─ Настройки ─────────────────────────────────────────────────┐
local SCAN_INTERVAL   = 1.5                        -- сек. между сканами
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 40, 40) -- цвет ESP

-- Объекты-аномалии: само существование = аномалия (глубокий поиск)
local ANOMALY_ON_APPEAR = {
    -- Игровые аномалии
    AnomalyDoor      = true,
    BubblegumSpawn   = true,
    Camouflage       = true,
    CarnisSpawn      = true,
    EletricPuddle    = true,
    Fog              = true,
    SCP096           = true,
    Stalker          = true,
    BloodPart        = true,
    Help             = true,
    WallDestroyEffect= true,
    -- Камеры
    ExtraCamera1     = true,
    ExtraCamera2     = true,
    -- Двери / часы
    Door3            = true,
    EyeClock         = true,
    -- Знаки / вентиляция
    ArrowSign2       = true,
    Vent1Hidden      = true,
}

-- Объекты, которые ОБЯЗАНЫ существовать; отсутствие = аномалия
local REQUIRED_OBJECTS = { "Camera1", "Camera2" }

-- Парты, ИЗМЕНЕНИЕ свойств которых = аномалия (сравниваем с Segment000)
local WATCH_PART_NAMES = {
    "ArrowSign",
    "CameraFrame", "FlowersSign",
    "Frame1", "Frame2", "Frame3", "Frame4",
    "TrashSign",
    "Vent1", "Vent2",
    "WallExitSign",
}

-- Имена объектов, которые НИКОГДА не считаются лишними
local IGNORE_NAMES = {
    AnomalyCounter = true, -- счётчик игрока
    John           = true, -- тело НПС (проверяем его детей отдельно)
}

-- Папки, прямые дети которых сравниваются с эталоном (1 уровень)
local COMPARE_FOLDERS = { "Debris", "Lateral", "Objects" }

-- Spawn-папки: любые дети внутри = аномалия
local SPAWN_FOLDERS = { "PuddleSpawn", "ShadowSpawn" }

-- Сегменты, которые скипаются (не сканируются вообще)
local IGNORE_SEGMENTS = {
    Start      = true,
    Segment000 = true,
}
-- └─────────────────────────────────────────────────────────────┘

-- ── Инициализация ──────────────────────────────────────────────
local mapSegments = workspace:WaitForChild("MapSegments", 10)
if not mapSegments then
    warn("[AnomalyDetector] workspace.MapSegments не найден!") return
end
local reference = mapSegments:WaitForChild("Segment000", 10)
if not reference then
    warn("[AnomalyDetector] Segment000 не найден!") return
end

-- ── Система снапшотов ──────────────────────────────────────────

-- Снимок ключевых визуальных свойств BasePart
local function snapPart(part)
    if not part:IsA("BasePart") then return nil end
    return {
        Color        = part.Color,
        Material     = part.Material,
        Size         = part.Size,
        Transparency = part.Transparency,
    }
end

-- Проверка: изменился ли парт относительно снапшота?
local function partMutated(part, snap)
    if not snap then return false end
    return part.Color        ~= snap.Color
        or part.Material     ~= snap.Material
        or part.Size         ~= snap.Size
        or math.abs(part.Transparency - snap.Transparency) > 0.05
end

-- Снапшот всей модели (все BasePart-потомки по имени + счётчик)
local function snapModel(model)
    local s = { _count = 0 }
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            s._count += 1
            s[d.Name] = snapPart(d)
        end
    end
    return s
end

-- Изменилась ли модель по сравнению со снапшотом?
local function modelMutated(model, snap)
    if not snap then return false end
    local count = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            count += 1
            if partMutated(d, snap[d.Name]) then return true end
        end
    end
    return count ~= snap._count
end

-- ── Сборка снапшотов из Segment000 ────────────────────────────

local refPartSnaps   = {}   -- [partName] = snap
local refFolderSets  = {}   -- [folderName] = {childName=true,...}
local refCaseSnap    = nil  -- снапшот Case NPC John
local refFaceSnap    = nil  -- {Texture} лица НПС John

local function buildSnapshots()
    -- Наблюдаемые парты
    for _, name in ipairs(WATCH_PART_NAMES) do
        local p = reference:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then
            refPartSnaps[name] = snapPart(p)
        end
    end

    -- Наборы прямых детей сравниваемых папок
    for _, fn in ipairs(COMPARE_FOLDERS) do
        local folder = reference:FindFirstChild(fn)
        if folder then
            local set = {}
            for _, child in ipairs(folder:GetChildren()) do
                set[child.Name] = true
            end
            refFolderSets[fn] = set
        end
    end

    -- НПС John: Case и лицо
    local debris = reference:FindFirstChild("Debris")
    if debris then
        local john = debris:FindFirstChild("John")
        if john then
            -- Case
            local case = john:FindFirstChild("Case")
            if case then
                refCaseSnap = snapModel(case)
            end
            -- Face декаль
            local head = john:FindFirstChild("Head")
            if head then
                local face = head:FindFirstChild("face")
                          or head:FindFirstChildOfClass("Decal")
                if face and face:IsA("Decal") then
                    refFaceSnap = { Texture = face.Texture }
                end
            end
        end
    end
end

buildSnapshots()

-- ── GUI ────────────────────────────────────────────────────────

local function buildGui()
    local pg  = player:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("AnomalyHUD")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name          = "AnomalyHUD"
    sg.ResetOnSpawn  = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent        = pg

    -- Фон панели
    local frame = Instance.new("Frame")
    frame.Name                   = "Panel"
    frame.Size                   = UDim2.new(0, 280, 0, 100)
    frame.Position               = UDim2.new(1, -295, 1, -115)
    frame.BackgroundColor3       = Color3.fromRGB(6, 6, 10)
    frame.BackgroundTransparency = 0.18
    frame.BorderSizePixel        = 0
    frame.Parent                 = sg

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent       = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color     = Color3.fromRGB(190, 25, 25)
    stroke.Thickness = 1.5
    stroke.Parent    = frame

    -- Хелпер для TextLabel
    local function makeLabel(name, posY, color, text, bold)
        local l = Instance.new("TextLabel")
        l.Name                  = name
        l.Size                  = UDim2.new(1, -16, 0, 18)
        l.Position              = UDim2.new(0, 10, 0, posY)
        l.BackgroundTransparency= 1
        l.TextColor3            = color
        l.TextSize              = 12
        l.Font                  = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextXAlignment        = Enum.TextXAlignment.Left
        l.Text                  = text
        l.Parent                = frame
        return l
    end

    makeLabel("Title",       6,  Color3.fromRGB(220, 55, 55),  "⚠  ANOMALY DETECTOR", true)
    makeLabel("SegLabel",   30,  Color3.fromRGB(195, 195, 195), "Сегмент: —",           false)
    makeLabel("CountLabel", 52,  Color3.fromRGB(195, 195, 195), "Аномалий: 0",          false)
    makeLabel("MissLabel",  74,  Color3.fromRGB(255, 165, 50),  "",                     false)

    return sg
end

local gui        = buildGui()
local panel      = gui:WaitForChild("Panel")
local segLabel   = panel:WaitForChild("SegLabel")
local countLabel = panel:WaitForChild("CountLabel")
local missLabel  = panel:WaitForChild("MissLabel")

-- ── Утилиты ────────────────────────────────────────────────────

-- Позиция сегмента (PrimaryPart или первый BasePart)
local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

-- Ближайший сегмент к игроку
local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and not IGNORE_SEGMENTS[seg.Name] then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestD then best, bestD = seg, d end
        end
    end
    return best
end

-- Добавить подсветку на объект
local function addHighlight(obj)
    if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end
    if obj:FindFirstChildOfClass("Highlight") then return end
    local h = Instance.new("Highlight")
    h.FillColor           = HIGHLIGHT_COLOR
    h.OutlineColor        = HIGHLIGHT_COLOR
    h.FillTransparency    = 0.55
    h.OutlineTransparency = 0
    h.Adornee = obj
    h.Parent  = obj
end

-- Убрать все наши Highlight-ы из сегмента
local function clearHighlights(seg)
    for _, h in ipairs(seg:GetDescendants()) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- ── Сканирование сегмента ──────────────────────────────────────

local function scanSeg(seg)
    local flagged  = {}  -- объекты для подсветки
    local missing  = {}  -- имена пропавших обязательных объектов

    local function flag(obj)
        if obj then
            -- Убеждаемся, что это не тело John и не AnomalyCounter
            if not IGNORE_NAMES[obj.Name] then
                table.insert(flagged, obj)
            end
        end
    end

    -- ╔═ ① Глубокий поиск: объекты из чёрного списка ═════════╗
    for _, obj in ipairs(seg:GetDescendants()) do
        if ANOMALY_ON_APPEAR[obj.Name] and not IGNORE_NAMES[obj.Name] then
            flag(obj)
        end
    end

    -- ╔═ ② Лишние прямые дети папок (vs Segment000) ════════════╗
    --   (ловит всё, что не есть в эталоне и не в IGNORE_NAMES)
    for _, fn in ipairs(COMPARE_FOLDERS) do
        local refSet = refFolderSets[fn]
        local folder = seg:FindFirstChild(fn)
        if folder and refSet then
            for _, child in ipairs(folder:GetChildren()) do
                if not IGNORE_NAMES[child.Name]
                and not refSet[child.Name] then
                    flag(child)
                end
            end
        end
    end

    -- ╔═ ③ Spawn-папки: любые дети = аномалия ══════════════════╗
    local refs = seg:FindFirstChild("References")
    if refs then
        for _, fn in ipairs(SPAWN_FOLDERS) do
            local folder = refs:FindFirstChild(fn)
            if folder then
                for _, child in ipairs(folder:GetChildren()) do
                    flag(child)
                end
            end
        end
    end

    -- ╔═ ④ Обязательные объекты: отсутствие = аномалия ═════════╗
    for _, name in ipairs(REQUIRED_OBJECTS) do
        if not seg:FindFirstChild(name, true) then
            table.insert(missing, name)
        end
    end

    -- ╔═ ⑤ Наблюдаемые парты: изменение свойств ════════════════╗
    for _, name in ipairs(WATCH_PART_NAMES) do
        local snap = refPartSnaps[name]
        if snap then
            local part = seg:FindFirstChild(name, true)
            if part and part:IsA("BasePart") and partMutated(part, snap) then
                flag(part)
            end
        end
    end

    -- ╔═ ⑥ НПС John → Case (изменение модели) ══════════════════╗
    if refCaseSnap then
        local debris = seg:FindFirstChild("Debris")
        if debris then
            local john = debris:FindFirstChild("John")
            if john then
                local case = john:FindFirstChild("Case")
                -- Подсвечиваем Case, но не самого John
                if case and modelMutated(case, refCaseSnap) then
                    table.insert(flagged, case)
                end
            end
        end
    end

    -- ╔═ ⑦ НПС John → Head → face (смена текстуры) ════════════╗
    if refFaceSnap then
        local debris = seg:FindFirstChild("Debris")
        if debris then
            local john = debris:FindFirstChild("John")
            if john then
                local head = john:FindFirstChild("Head")
                if head then
                    local face = head:FindFirstChild("face")
                              or head:FindFirstChildOfClass("Decal")
                    -- Подсвечиваем Head, не John целиком
                    if face and face:IsA("Decal")
                    and face.Texture ~= refFaceSnap.Texture then
                        table.insert(flagged, head)
                    end
                end
            end
        end
    end

    return flagged, missing
end

-- ── Главный цикл ───────────────────────────────────────────────

local lastSeg      = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_INTERVAL then return end
    lastScanTime = now

    local seg = getNearestSeg()

    -- Нет сегмента рядом
    if not seg then
        segLabel.Text  = "Сегмент: не найден"
        countLabel.Text = "Аномалий: —"
        missLabel.Text  = ""
        return
    end

    -- Сброс подсветки при смене зоны
    if lastSeg and lastSeg ~= seg then
        clearHighlights(lastSeg)
    end
    lastSeg = seg

    -- Обновляем название зоны
    segLabel.Text = "Сегмент: " .. seg.Name

    -- Сканируем
    local anomObjs, missList = scanSeg(seg)

    -- Перерисовываем подсветку
    clearHighlights(seg)
    for _, obj in ipairs(anomObjs) do
        addHighlight(obj)
    end

    -- Общий счёт = видимые аномалии + пропавшие объекты
    local total = #anomObjs + #missList
    countLabel.Text = "Аномалий: " .. total
    countLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)

    -- Строка с пропавшими объектами
    if #missList > 0 then
        missLabel.Text = "Нет: " .. table.concat(missList, ", ")
    else
        missLabel.Text = ""
    end
end)

print("[AnomalyDetector v2] Запущен. Интервал:", SCAN_INTERVAL, "сек.")

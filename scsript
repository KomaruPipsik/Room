-- ║   Помести в StarterPlayerScripts                            ║
-- ╚══════════════════════════════════════════════════════════════╝
--
-- Структура сегмента:
--   Debris/       → NPC John (не трогаем)
--   Lateral/      → Lamps (не трогаем)
--   Objects/      → Camera1, Camera2, Door1, Door2, Door3,
--                   CeilingExitSign, EyeClock, TrashBin
--   References/   → PuddleSpawn/, ShadowSpawn/
--
-- Аномалии:
--   1. В Objects/ появился объект, которого не было в Segment000
--      (ExtraCamera1, ExtraCamera2 — частный случай этого)
--   2. В PuddleSpawn/ или ShadowSpawn/ появились дети сверх эталона
--   3. В сегменте появился объект из ANOMALY_NAMES (кроме Debris)
-- ─────────────────────────────────────────────────────────────────

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local player     = Players.LocalPlayer

-- ┌─ Настройки ──────────────────────────────────────────────────┐
local SCAN_INTERVAL   = 1.5
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 40, 40)

-- Объекты, само появление которых = аномалия (ищем везде кроме Debris)
local ANOMALY_NAMES = {
    AnomalyDoor       = true,
    BubblegumSpawn    = true,
    Camouflage        = true,
    CarnisSpawn       = true,
    EletricPuddle     = true,
    Fog               = true,
    SCP096            = true,
    Stalker           = true,
    BloodPart         = true,
    Help              = true,
    WallDestroyEffect = true,
}

-- Папки внутри References, появление лишних детей в которых = аномалия
local SPAWN_FOLDERS = { "PuddleSpawn", "ShadowSpawn" }
-- └─────────────────────────────────────────────────────────────┘

-- ── Инициализация ──────────────────────────────────────────────
local mapSegments = workspace:WaitForChild("MapSegments", 10)
if not mapSegments then
    warn("[AnomalyDetector] workspace.MapSegments не найден!") return
end

local reference = mapSegments:WaitForChild("Segment000", 10)
if not reference then
    warn("[AnomalyDetector] Segment000 не найден!") return
end

-- ── Снапшот эталона ────────────────────────────────────────────
-- Запоминаем, какие имена есть в Objects/ у Segment000
local refObjectNames = {}
do
    local objFolder = reference:FindFirstChild("Objects")
    if objFolder then
        for _, c in ipairs(objFolder:GetChildren()) do
            refObjectNames[c.Name] = true
        end
    end
end

-- Запоминаем, какие имена есть в каждой spawn-папке у Segment000
local refSpawnNames = {}    -- refSpawnNames["PuddleSpawn"]["Part1"] = true
do
    local refRefs = reference:FindFirstChild("References")
    if refRefs then
        for _, folderName in ipairs(SPAWN_FOLDERS) do
            refSpawnNames[folderName] = {}
            local folder = refRefs:FindFirstChild(folderName)
            if folder then
                for _, c in ipairs(folder:GetChildren()) do
                    refSpawnNames[folderName][c.Name] = true
                end
            end
        end
    end
end

-- ── GUI ────────────────────────────────────────────────────────
local function buildGui()
    local pg  = player:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("AnomalyHUD")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name           = "AnomalyHUD"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent         = pg

    local frame = Instance.new("Frame")
    frame.Name                   = "Panel"
    frame.Size                   = UDim2.new(0, 280, 0, 80)
    frame.Position               = UDim2.new(1, -295, 1, -95)
    frame.BackgroundColor3       = Color3.fromRGB(6, 6, 10)
    frame.BackgroundTransparency = 0.18
    frame.BorderSizePixel        = 0
    frame.Parent                 = sg

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color     = Color3.fromRGB(190, 25, 25)
    stroke.Thickness = 1.5

    local function lbl(name, y, color, text, bold)
        local l = Instance.new("TextLabel", frame)
        l.Name                   = name
        l.Size                   = UDim2.new(1, -16, 0, 18)
        l.Position               = UDim2.new(0, 10, 0, y)
        l.BackgroundTransparency = 1
        l.TextColor3             = color
        l.TextSize               = 12
        l.Font                   = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextXAlignment         = Enum.TextXAlignment.Left
        l.Text                   = text
        return l
    end

    lbl("Title",    6,  Color3.fromRGB(220, 55, 55),  "⚠  ANOMALY DETECTOR", true)
    lbl("SegLabel", 30, Color3.fromRGB(195, 195, 195), "Сегмент: —",          false)
    lbl("CntLabel", 52, Color3.fromRGB(195, 195, 195), "Аномалий: 0",         false)

    return sg
end

local gui      = buildGui()
local panel    = gui:WaitForChild("Panel")
local segLabel = panel:WaitForChild("SegLabel")
local cntLabel = panel:WaitForChild("CntLabel")

-- ── Утилиты ────────────────────────────────────────────────────
local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and seg.Name ~= "Start" then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestD then best, bestD = seg, d end
        end
    end
    return best
end

-- ── Подсветка ──────────────────────────────────────────────────
-- Highlight работает только с BasePart и Model.
-- Для остальных типов поднимаемся к ближайшему подходящему предку.
local function findTarget(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then return obj end
    -- Есть потомки-BasePart?
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    -- Поднимаемся
    local p = obj.Parent
    while p and p ~= mapSegments do
        if p:IsA("BasePart") or p:IsA("Model") then return p end
        p = p.Parent
    end
    return nil
end

local function addHighlight(obj)
    local target = findTarget(obj)
    if not target then return end

    if target:IsA("BasePart") and target.Transparency >= 1 then return end
    if target:IsA("Model") then
        local vis = false
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 then vis = true; break end
        end
        if not vis then return end
    end

    if target:FindFirstChildOfClass("Highlight") then return end
    local h               = Instance.new("Highlight")
    h.FillColor           = HIGHLIGHT_COLOR
    h.OutlineColor        = HIGHLIGHT_COLOR
    h.FillTransparency    = 0.55
    h.OutlineTransparency = 0
    h.Adornee             = target
    h.Parent              = target
end

local function clearHighlights(seg)
    for _, h in ipairs(seg:GetDescendants()) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- ── Сканирование ───────────────────────────────────────────────
local function scanSeg(seg)
    local anomObjs = {}

    local debris = seg:FindFirstChild("Debris")

    -- ① Объекты из чёрного списка ANOMALY_NAMES
    --    Ищем везде в сегменте, кроме папки Debris (там John — NPC, не трогаем)
    for _, obj in ipairs(seg:GetDescendants()) do
        if ANOMALY_NAMES[obj.Name] then
            if not (debris and obj:IsDescendantOf(debris)) then
                table.insert(anomObjs, obj)
            end
        end
    end

    -- ② Objects/ — лишние объекты сверх эталона
    --    (ExtraCamera1, ExtraCamera2 попадают сюда автоматически)
    local objFolder = seg:FindFirstChild("Objects")
    if objFolder then
        for _, c in ipairs(objFolder:GetChildren()) do
            if not refObjectNames[c.Name] then
                table.insert(anomObjs, c)
            end
        end
    end

    -- ③ References/PuddleSpawn и ShadowSpawn — лишние дети сверх эталона
    local refs = seg:FindFirstChild("References")
    if refs then
        for _, folderName in ipairs(SPAWN_FOLDERS) do
            local folder    = refs:FindFirstChild(folderName)
            local refNames  = refSpawnNames[folderName] or {}
            if folder then
                for _, c in ipairs(folder:GetChildren()) do
                    if not refNames[c.Name] then
                        table.insert(anomObjs, c)
                    end
                end
            end
        end
    end

    return anomObjs
end

-- ── Главный цикл ───────────────────────────────────────────────
local lastSeg      = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_INTERVAL then return end
    lastScanTime = now

    local seg = getNearestSeg()

    if not seg then
        segLabel.Text = "Сегмент: не найден"
        cntLabel.Text = "Аномалий: —"
        return
    end

    if lastSeg and lastSeg ~= seg then
        clearHighlights(lastSeg)
    end
    lastSeg = seg

    segLabel.Text = "Сегмент: " .. seg.Name

    -- Segment000 — эталон, сканировать нет смысла
    if seg == reference then
        cntLabel.Text       = "Аномалий: 0"
        cntLabel.TextColor3 = Color3.fromRGB(90, 215, 90)
        return
    end

    local anomObjs = scanSeg(seg)

    clearHighlights(seg)
    for _, obj in ipairs(anomObjs) do
        addHighlight(obj)
    end

    local total = #anomObjs
    cntLabel.Text       = "Аномалий: " .. total
    cntLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)
end)

print("[AnomalyDetector v5] Запущен. Интервал:", SCAN_INTERVAL, "сек.")

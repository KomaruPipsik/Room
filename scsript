                        if child:IsA("BasePart") or child:IsA("Model") then
                           -- Тут можно добавить более точное сравнение, но пока считаем по списку выше
                        end
                    end
                end

                counterLabel.Text = "Сегмент: " .. currentSeg.Name .. "\nАномалий: " .. anomaliesCount
                

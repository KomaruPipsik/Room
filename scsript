-- v4: Полностью переписана логика:
--   • Сравнение текущего сегмента с Segment000 по иерархическому пути
--   • Segment000 больше не игнорируется при определении позиции игрока
--   • Подсветка работает для любых типов объектов (Folder, Script, Decal и т.д.)
--   • Убраны списки ANOMALY_ON_APPEAR — они давали ложные срабатывания
-- ─────────────────────────────────────────────────────────────────

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local player     = Players.LocalPlayer

-- ┌─ Настройки ─────────────────────────────────────────────────┐
local SCAN_INTERVAL   = 1.5
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 40, 40)
-- └─────────────────────────────────────────────────────────────┘

-- ── Инициализация ──────────────────────────────────────────────
local mapSegments = workspace:WaitForChild("MapSegments", 10)
if not mapSegments then
    warn("[AnomalyDetector] workspace.MapSegments не найден!") return
end
local reference = mapSegments:WaitForChild("Segment000", 10)
if not reference then
    warn("[AnomalyDetector] Segment000 не найден!") return
end

-- ── Снапшот ─────────────────────────────────────────────────────
-- Возвращает путь объекта относительно корня сегмента
-- Например: "Debris/John/Head" или "ArrowSign"
local function getPath(obj, root)
    local parts = {}
    local cur = obj
    while cur and cur ~= root do
        table.insert(parts, 1, cur.Name)
        cur = cur.Parent
    end
    return table.concat(parts, "/")
end

-- Строит снапшот всех потомков модели:
-- path → { class, color?, texture?, shirt?, pants? }
local function buildSnapshot(model)
    local snap = {}
    for _, obj in ipairs(model:GetDescendants()) do
        local path  = getPath(obj, model)
        local entry = { class = obj.ClassName }
        if obj:IsA("BasePart") then
            entry.color = obj.Color
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            entry.texture = obj.Texture
        elseif obj:IsA("Shirt") then
            entry.shirt = obj.ShirtTemplate
        elseif obj:IsA("Pants") then
            entry.pants = obj.PantsTemplate
        end
        snap[path] = entry
    end
    return snap
end

-- Снапшот Segment000 — эталон
local refSnap = buildSnapshot(reference)

-- ── GUI ────────────────────────────────────────────────────────
local function buildGui()
    local pg  = player:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("AnomalyHUD")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name           = "AnomalyHUD"
    sg.ResetOnSpawn   = false
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.Parent         = pg

    local frame = Instance.new("Frame")
    frame.Name                   = "Panel"
    frame.Size                   = UDim2.new(0, 280, 0, 100)
    frame.Position               = UDim2.new(1, -295, 1, -115)
    frame.BackgroundColor3       = Color3.fromRGB(6, 6, 10)
    frame.BackgroundTransparency = 0.18
    frame.BorderSizePixel        = 0
    frame.Parent                 = sg

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color     = Color3.fromRGB(190, 25, 25)
    stroke.Thickness = 1.5

    local function lbl(name, y, color, text, bold)
        local l = Instance.new("TextLabel", frame)
        l.Name                   = name
        l.Size                   = UDim2.new(1, -16, 0, 18)
        l.Position               = UDim2.new(0, 10, 0, y)
        l.BackgroundTransparency = 1
        l.TextColor3             = color
        l.TextSize               = 12
        l.Font                   = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextXAlignment         = Enum.TextXAlignment.Left
        l.Text                   = text
        return l
    end

    lbl("Title",    6,  Color3.fromRGB(220, 55, 55),  "⚠  ANOMALY DETECTOR", true)
    lbl("SegLabel", 30, Color3.fromRGB(195, 195, 195), "Сегмент: —",          false)
    lbl("CntLabel", 52, Color3.fromRGB(195, 195, 195), "Аномалий: 0",         false)
    lbl("MisLabel", 74, Color3.fromRGB(255, 165, 50),  "",                    false)

    return sg
end

local gui      = buildGui()
local panel    = gui:WaitForChild("Panel")
local segLabel = panel:WaitForChild("SegLabel")
local cntLabel = panel:WaitForChild("CntLabel")
local misLabel = panel:WaitForChild("MisLabel")

-- ── Утилиты ────────────────────────────────────────────────────
local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

-- Находит ближайший к игроку сегмент (включая Segment000,
-- исключая только Start — стартовую зону)
local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and seg.Name ~= "Start" then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestD then best, bestD = seg, d end
        end
    end
    return best
end

-- ── Подсветка ──────────────────────────────────────────────────

-- Ищем подходящий объект для Highlight:
-- Highlight работает только с BasePart и Model.
-- Если объект другого типа — поднимаемся к предку-Model/BasePart.
local function findHighlightTarget(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then
        return obj
    end
    -- Есть потомки-BasePart → создаём Model-контейнер нельзя,
    -- просто берём первый BasePart среди потомков
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    -- Иначе поднимаемся к предку
    local p = obj.Parent
    while p and p ~= mapSegments do
        if p:IsA("BasePart") or p:IsA("Model") then return p end
        p = p.Parent
    end
    return nil
end

local function addHighlight(obj)
    local target = findHighlightTarget(obj)
    if not target then return end

    -- Пропускаем полностью прозрачные
    if target:IsA("BasePart") and target.Transparency >= 1 then return end
    if target:IsA("Model") then
        local hasVisible = false
        for _, p in ipairs(target:GetDescendants()) do
            if p:IsA("BasePart") and p.Transparency < 1 then
                hasVisible = true; break
            end
        end
        if not hasVisible then return end
    end

    -- Не дублируем
    if target:FindFirstChildOfClass("Highlight") then return end

    local h               = Instance.new("Highlight")
    h.FillColor           = HIGHLIGHT_COLOR
    h.OutlineColor        = HIGHLIGHT_COLOR
    h.FillTransparency    = 0.55
    h.OutlineTransparency = 0
    h.Adornee             = target
    h.Parent              = target
end

local function clearHighlights(seg)
    for _, h in ipairs(seg:GetDescendants()) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- ── Сканирование ───────────────────────────────────────────────
local function scanSeg(seg)
    local anomObjs = {}  -- объекты для подсветки
    local missing  = {}  -- имена пропавших объектов

    -- Строим снапшот текущего сегмента
    local curSnap = {}
    for _, obj in ipairs(seg:GetDescendants()) do
        local path  = getPath(obj, seg)
        local entry = { class = obj.ClassName, obj = obj }
        if obj:IsA("BasePart") then
            entry.color = obj.Color
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            entry.texture = obj.Texture
        elseif obj:IsA("Shirt") then
            entry.shirt = obj.ShirtTemplate
        elseif obj:IsA("Pants") then
            entry.pants = obj.PantsTemplate
        end
        curSnap[path] = entry
    end

    -- ① Появилось или изменилось по сравнению с Segment000
    for path, cur in pairs(curSnap) do
        local ref = refSnap[path]
        if ref == nil then
            -- Объект появился — его не было в Segment000
            table.insert(anomObjs, cur.obj)
        else
            -- Объект есть в обоих — проверяем изменения
            local changed = false
            if cur.color   and ref.color   and cur.color   ~= ref.color   then changed = true end
            if cur.texture and ref.texture and cur.texture ~= ref.texture then changed = true end
            if cur.shirt   and ref.shirt   and cur.shirt   ~= ref.shirt   then changed = true end
            if cur.pants   and ref.pants   and cur.pants   ~= ref.pants   then changed = true end
            if changed then
                table.insert(anomObjs, cur.obj)
            end
        end
    end

    -- ② Пропало по сравнению с Segment000
    -- Добавляем только "корневые" пропавшие объекты
    -- (не добавляем потомков пропавшего родителя — они и так учтены)
    for path, _ in pairs(refSnap) do
        if curSnap[path] == nil then
            -- Проверяем — не пропал ли уже родитель
            local parentPath = path:match("^(.+)/[^/]+$")
            local parentAlsoMissing = parentPath and (curSnap[parentPath] == nil)
            if not parentAlsoMissing then
                local name = path:match("([^/]+)$") or path
                table.insert(missing, name)
            end
        end
    end

    return anomObjs, missing
end

-- ── Главный цикл ───────────────────────────────────────────────
local lastSeg      = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_INTERVAL then return end
    lastScanTime = now

    local seg = getNearestSeg()

    if not seg then
        segLabel.Text = "Сегмент: не найден"
        cntLabel.Text = "Аномалий: —"
        misLabel.Text = ""
        return
    end

    -- Сбрасываем подсветку при смене зоны
    if lastSeg and lastSeg ~= seg then
        clearHighlights(lastSeg)
    end
    lastSeg = seg

    segLabel.Text = "Сегмент: " .. seg.Name

    -- Segment000 — эталон, не сканируем
    if seg == reference then
        cntLabel.Text       = "Аномалий: 0"
        cntLabel.TextColor3 = Color3.fromRGB(90, 215, 90)
        misLabel.Text       = ""
        return
    end

    local anomObjs, missList = scanSeg(seg)

    -- Перерисовываем подсветку
    clearHighlights(seg)
    for _, obj in ipairs(anomObjs) do
        addHighlight(obj)
    end

    -- Обновляем GUI
    local total = #anomObjs + #missList
    cntLabel.Text       = "Аномалий: " .. total
    cntLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)

    -- Показываем не более 3 пропавших объектов чтобы не переполнять GUI
    if #missList > 0 then
        local shown = {}
        for i = 1, math.min(3, #missList) do
            table.insert(shown, missList[i])
        end
        local suffix = #missList > 3 and (" и ещё " .. (#missList - 3)) or ""
        misLabel.Text = "Нет: " .. table.concat(shown, ", ") .. suffix
    else
        misLabel.Text = ""
    end
end)

print("[AnomalyDetector v4] Запущен. Интервал:", SCAN_INTERVAL, "сек.")

local function clearHighlights()
    for _, h in ipairs(activeHL) do
        if h and h.Parent then h:Destroy() end
    end
    activeHL = {}
end

local function addHighlight(obj)
    if not hlOn then return end
    if not obj then return end
    local target = nil
    if obj:IsA("BasePart") or obj:IsA("Model") then
        target = obj
    else
        target = firstPart(obj) or obj.Parent
    end
    if not target then return end
    if target:FindFirstChildOfClass("Highlight") then return end
    local h               = Instance.new("Highlight")
    h.FillColor           = HL_COLOR
    h.OutlineColor        = HL_COLOR
    h.FillTransparency    = 0.55
    h.OutlineTransparency = 0
    h.Adornee             = target
    h.Parent              = target
    table.insert(activeHL, h)
end

local function applyXray(seg, enable)
    if not seg then return end
    for _, obj in ipairs(seg:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("wall") or n:find("floor") or n:find("ceiling") or n:find("panel") or n:find("tile") then
                if enable then
                    xraySaved[obj] = obj.Transparency
                    obj.Transparency = 0.88
                else
                    if xraySaved[obj] ~= nil then
                        obj.Transparency = xraySaved[obj]
                    end
                end
            end
        end
    end
    if not enable then xraySaved = {} end
end

local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestDist = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and seg.Name ~= "Start" then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestDist then best, bestDist = seg, d end
        end
    end
    return best
end

local function scanSeg(seg)
    local descs   = {}
    local targets = {}

    local function flag(desc, obj)
        table.insert(descs, desc)
        if obj then table.insert(targets, obj) end
    end

    local objFolder = seg:FindFirstChild("Objects")

    if objFolder then
        local snap = refSnap.objects or {}
        for _, name in ipairs(WATCHED_OBJECTS) do
            local ref = snap[name]
            local cur = deepFind(objFolder, name)
            if ref then
                if not cur then
                    flag(name .. ": исчез")
                else
                    local part = firstPart(cur)
                    if part then
                        if ref.Color and not colorEq(part.Color, ref.Color) then
                            flag(name .. ": изменён цвет", cur)
                        end
                        if ref.Size and not sizeEq(part.Size, ref.Size) then
                            flag(name .. ": изменён размер", cur)
                        end
                        if ref.Orientation and not rotEq(part.Orientation, ref.Orientation) then
                            flag(name .. ": изменено вращение", cur)
                        end
                    end
                end
            end
        end

        for _, name in ipairs(EXTRA_OBJECTS) do
            local obj = deepFind(objFolder, name)
            if not obj then obj = deepFind(seg, name) end
            if obj then
                flag("Появился объект: " .. name, obj)
            end
        end

        local arrow = deepFind(objFolder, "ArrowSign")
        if arrow and refSnap.arrowOri then
            local p = firstPart(arrow)
            if p and not rotEq(p.Orientation, refSnap.arrowOri) then
                flag("ArrowSign: повёрнут", arrow)
            end
        end

        local cf = deepFind(objFolder, "CameraFrame")
        if cf then
            local p = firstPart(cf)
            if p and not sizeEq(p.Size, CAM_FRAME_SIZE) then
                flag("CameraFrame: изменён размер", cf)
            end
        end

        local trashBin = deepFind(objFolder, "TrashBin") or deepFind(seg, "TrashBin")
        if trashBin then
            local p = firstPart(trashBin)
            if p then
                if not colorEq(p.Color, TRASH_COLOR) then
                    flag("TrashBin: неправильный цвет", trashBin)
                end
                if refSnap.trashPos then
                    if (p.Position - refSnap.trashPos).Magnitude > POS_EPS then
                        flag("TrashBin: сдвинута", trashBin)
                    end
                end
            end
        elseif not refSnap.trashMissing then
            flag("TrashBin: исчезла")
        end
    end

    for _, camName in ipairs({"Camera1","Camera2"}) do
        local cam = deepFind(seg, camName)
        if cam then
            local hasAttach = false
            local hasRed    = false
            for _, d in ipairs(cam:GetDescendants()) do
                if d:IsA("Attachment") then hasAttach = true end
                if d:IsA("BasePart") then
                    local c = d.Color
                    if c.R > 0.6 and c.G < 0.25 and c.B < 0.25 then hasRed = true end
                end
            end
            if hasAttach then flag(camName .. ": появился Attachment", cam) end
            if hasRed    then flag(camName .. ": красный цвет внутри", cam) end
        end
    end

    for _, vname in ipairs({"Vent1","Vent2","Vent1Hidden"}) do
        local vent = deepFind(seg, vname)
        if refSnap.vents[vname] and not vent then
            flag(vname .. ": исчез")
        elseif vent then
            local water = deepFind(vent, "Water")
            if water and water:IsA("BasePart") and water.Transparency < 0.8 then
                flag(vname .. ": видна Water", vent)
            end
        end
    end

    local refFolder = seg:FindFirstChild("References")
    if refFolder then
        for _, spawnName in ipairs({"ShadowSpawn","PuddleSpawn"}) do
            local sp = refFolder:FindFirstChild(spawnName)
            if sp then
                local kids = sp:GetChildren()
                if #kids > 0 then
                    flag(spawnName .. ": содержит " .. #kids .. " объект(ов)", sp)
                end
            end
        end
        for _, dname in ipairs(DANGER_REFS) do
            local obj = deepFind(refFolder, dname)
            if obj then flag("References: " .. dname, obj) end
        end
    end

    local john = deepFind(seg, "John")
    if john then
        local hair = deepFind(john, "Hair") or deepFind(john, "HairMesh")
        if hair then
            local p = firstPart(hair)
            if p and not colorEq(p.Color, JOHN_COLOR) then
                flag("John: неправильный цвет волос", john)
            end
        end

        local caseObj = deepFind(john, "Case")
        if caseObj then
            local cp = firstPart(caseObj)
            if cp and not colorEq(cp.Color, JOHN_COLOR) then
                flag("John: неправильный цвет чемодана", john)
            end

            local leftArm = john:FindFirstChild("Left Arm") or john:FindFirstChild("LeftHand")
            if leftArm then
                local cur = caseObj.Parent
                local inLeft = false
                while cur and cur ~= john do
                    if cur == leftArm then inLeft = true break end
                    cur = cur.Parent
                end
                if inLeft then
                    flag("John: чемодан в левой руке", john)
                end
            end
        end

        local head = john:FindFirstChild("Head")
        if head then
            local face = head:FindFirstChild("face") or head:FindFirstChild("Face")
            if face and face:IsA("Decal") and face.Texture ~= JOHN_FACE_ID then
                flag("John: неправильное лицо", john)
            end
        end
    end

    return descs, targets
end

UserInputService.InputBegan:Connect(function(input, proc)
    if proc then return end
    if input.KeyCode == Enum.KeyCode.Z then
        xrayOn = not xrayOn
        applyXray(lastSeg, xrayOn)
    elseif input.KeyCode == Enum.KeyCode.H then
        hlOn = not hlOn
        if not hlOn then
            clearHighlights()
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        mouseUnlocked = not mouseUnlocked
        UserInputService.MouseBehavior = mouseUnlocked
            and Enum.MouseBehavior.Default
            or  Enum.MouseBehavior.LockCenter
    end
end)

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_RATE then return end
    lastScanTime = now

    local seg = getNearestSeg()
    if not seg then
        segLabel.Text = "Сегмент: не найден"
        cntLabel.Text = "Аномалий: —"
        return
    end

    if lastSeg and lastSeg ~= seg then
        clearHighlights()
        if xrayOn then
            applyXray(lastSeg, false)
            xrayOn = false
        end
    end
    lastSeg = seg

    segLabel.Text = "Сегмент: " .. seg.Name

    if seg == reference then
        clearHighlights()
        cntLabel.Text       = "Аномалий: 0"
        cntLabel.TextColor3 = Color3.fromRGB(90, 215, 90)
        updateList({})
        return
    end

    local descs, targets = scanSeg(seg)

    clearHighlights()
    if hlOn then
        for _, obj in ipairs(targets) do
            addHighlight(obj)
        end
    end

    local total = #descs
    cntLabel.Text       = "Аномалий: " .. total
    cntLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)

    updateList(descs)
end)


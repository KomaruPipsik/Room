    "TrashBin",   -- норма RGB(99, 95, 98)
    "Door1", "Door2",
}

-- Парты, изменение ВРАЩЕНИЯ которых = аномалия (сравниваем с Segment000)
local WATCH_ROTATION = {
    "ArrowSign",
    "FlowersSign", "Frame1", "Frame2", "Frame3", "Frame4",
    "Door1", "Door2",
}

-- Парты, изменение РАЗМЕРА которых = аномалия
local WATCH_SIZE = {
    -- CameraFrame, нормальный размер (X, Y, Z):
    { name = "CameraFrame", size = Vector3.new(0.2627061903476715, 2.7990925312042236, 3.4167513847351074) },
}

local ROT_EPS  = 0.5   -- допуск вращения, градусы
local SIZE_EPS = 0.01  -- допуск размера, студы

-- Spawn-папки: любые дети внутри = аномалия
local SPAWN_FOLDERS = { "PuddleSpawn", "ShadowSpawn" }

-- Сегменты, которые пропускаются при поиске ближайшего
-- Segment000 убран — теперь он корректно показывается когда игрок рядом
local IGNORE_SEGMENTS = { Start = true }

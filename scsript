-- Функция для уведомления (можно заменить на GUI)
local function notifyAnomaly(text, obj)
    print("!!! АНОМАЛИЯ ОБНАРУЖЕНА !!!")
    print("Причина: " .. text)
    if obj then
        print("Объект: " .. obj:GetFullName())
        -- Подсвечиваем аномалию, чтобы видеть сквозь стены
        local h = Instance.new("Highlight")
        h.Parent = obj
        h.FillColor = Color3.fromRGB(255, 0, 0)
    end
    
    -- Стандартное уведомление Roblox в углу экрана
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Anomaly Found!",
        Text = text,
        Duration = 5
    })
end


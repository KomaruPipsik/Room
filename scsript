-- ANOMALY DETECTOR v5 — LocalScript
-- Помести в StarterPlayerScripts
--
-- Логика простая:
--   1. При старте запоминаем снапшот Segment000 (путь → цвет, размер, вращение)
--   2. Каждые 1.5 сек смотрим какой сегмент ближайший
--   3. Всё что в нём отличается от Segment000 — подсвечиваем красным
--
-- Пропускаем:
--   • Debris (там John — NPC, меняется в рантайме)
--   • AnomalyCounter (служебный объект)

local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local player     = Players.LocalPlayer

local SCAN_INTERVAL   = 1.5
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 40, 40)
local ROT_EPS         = 1.0    -- допуск вращения в градусах
local SIZE_EPS        = 0.05   -- допуск размера в студах

-- ── Инициализация ──────────────────────────────────────────────
local mapSegments = workspace:WaitForChild("MapSegments", 10)
if not mapSegments then warn("[AD] MapSegments не найден!") return end

local reference = mapSegments:WaitForChild("Segment000", 10)
if not reference then warn("[AD] Segment000 не найден!") return end

-- ── Снапшот ────────────────────────────────────────────────────
-- Путь объекта относительно корня сегмента, например "Objects/Door1"
local function getPath(obj, root)
    local parts = {}
    local cur = obj
    while cur and cur ~= root do
        table.insert(parts, 1, cur.Name)
        cur = cur.Parent
    end
    return table.concat(parts, "/")
end

-- Проверяем — находится ли объект внутри папки Debris
local function inDebris(obj, root)
    local p = obj.Parent
    while p and p ~= root do
        if p.Name == "Debris" then return true end
        p = p.Parent
    end
    return false
end

-- Строим снапшот: path → { Color?, Size?, Orientation? }
-- Пропускаем Debris (John) и AnomalyCounter
local function buildSnap(model)
    local snap = {}
    for _, obj in ipairs(model:GetDescendants()) do
        if obj.Name == "AnomalyCounter" then continue end
        if inDebris(obj, model) then continue end

        local path  = getPath(obj, model)
        local entry = { exists = true }
        if obj:IsA("BasePart") then
            entry.Color       = obj.Color
            entry.Size        = obj.Size
            entry.Orientation = obj.Orientation
        end
        snap[path] = entry
    end
    return snap
end

local refSnap = buildSnap(reference)

-- ── GUI ────────────────────────────────────────────────────────
local function buildGui()
    local pg  = player:WaitForChild("PlayerGui")
    local old = pg:FindFirstChild("AnomalyHUD")
    if old then old:Destroy() end

    local sg = Instance.new("ScreenGui")
    sg.Name           = "AnomalyHUD"
    sg.ResetOnSpawn   = false
    sg.Parent         = pg

    local frame = Instance.new("Frame", sg)
    frame.Name                   = "Panel"
    frame.Size                   = UDim2.new(0, 260, 0, 80)
    frame.Position               = UDim2.new(1, -275, 1, -95)
    frame.BackgroundColor3       = Color3.fromRGB(6, 6, 10)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel        = 0

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", frame)
    stroke.Color     = Color3.fromRGB(180, 20, 20)
    stroke.Thickness = 1.5

    local function lbl(name, y, color, text, bold)
        local l = Instance.new("TextLabel", frame)
        l.Name                   = name
        l.Size                   = UDim2.new(1, -12, 0, 20)
        l.Position               = UDim2.new(0, 8, 0, y)
        l.BackgroundTransparency = 1
        l.TextColor3             = color
        l.TextSize               = 13
        l.Font                   = bold and Enum.Font.GothamBold or Enum.Font.Gotham
        l.TextXAlignment         = Enum.TextXAlignment.Left
        l.Text                   = text
        return l
    end

    lbl("Title",    6,  Color3.fromRGB(220, 50, 50),  "⚠  ANOMALY DETECTOR", true)
    lbl("SegLabel", 30, Color3.fromRGB(200, 200, 200), "Сегмент: —",          false)
    lbl("CntLabel", 54, Color3.fromRGB(200, 200, 200), "Аномалий: 0",         false)

    return sg
end

local gui      = buildGui()
local panel    = gui.Panel
local segLabel = panel.SegLabel
local cntLabel = panel.CntLabel

-- ── Утилиты ────────────────────────────────────────────────────
local function getSegPos(seg)
    if seg.PrimaryPart then return seg.PrimaryPart.Position end
    for _, v in ipairs(seg:GetDescendants()) do
        if v:IsA("BasePart") then return v.Position end
    end
    return Vector3.zero
end

local function getNearestSeg()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD = nil, math.huge
    for _, seg in ipairs(mapSegments:GetChildren()) do
        if seg:IsA("Model") and seg.Name ~= "Start" then
            local d = (root.Position - getSegPos(seg)).Magnitude
            if d < bestD then best, bestD = seg, d end
        end
    end
    return best
end

-- Подсветка
local function findTarget(obj)
    if obj:IsA("BasePart") or obj:IsA("Model") then return obj end
    for _, d in ipairs(obj:GetDescendants()) do
        if d:IsA("BasePart") then return d end
    end
    local p = obj.Parent
    while p and p ~= mapSegments do
        if p:IsA("BasePart") or p:IsA("Model") then return p end
        p = p.Parent
    end
    return nil
end

local function addHighlight(obj)
    local t = findTarget(obj)
    if not t then return end
    if t:IsA("BasePart") and t.Transparency >= 1 then return end
    if t:FindFirstChildOfClass("Highlight") then return end
    local h               = Instance.new("Highlight")
    h.FillColor           = HIGHLIGHT_COLOR
    h.OutlineColor        = HIGHLIGHT_COLOR
    h.FillTransparency    = 0.55
    h.OutlineTransparency = 0
    h.Adornee             = t
    h.Parent              = t
end

local function clearHighlights(seg)
    for _, h in ipairs(seg:GetDescendants()) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- ── Вспомогательные сравнения ──────────────────────────────────
local function rotEq(a, b)
    return math.abs(a.X - b.X) <= ROT_EPS
       and math.abs(a.Y - b.Y) <= ROT_EPS
       and math.abs(a.Z - b.Z) <= ROT_EPS
end

local function sizeEq(a, b)
    return math.abs(a.X - b.X) <= SIZE_EPS
       and math.abs(a.Y - b.Y) <= SIZE_EPS
       and math.abs(a.Z - b.Z) <= SIZE_EPS
end

-- Возвращает объект по пути внутри модели
local function objByPath(model, path)
    local cur = model
    for part in path:gmatch("[^/]+") do
        cur = cur and cur:FindFirstChild(part)
    end
    return cur
end

-- ── Сканирование ───────────────────────────────────────────────
local function scanSeg(seg)
    local anomalies    = {}   -- объекты для подсветки
    local missingCount = 0    -- пропавших объектов (подсветить нельзя — их нет)

    local curSnap = buildSnap(seg)

    -- Объекты которые ПОЯВИЛИСЬ (нет в 000)
    for path in pairs(curSnap) do
        if refSnap[path] == nil then
            local obj = objByPath(seg, path)
            if obj then table.insert(anomalies, obj) end
        end
    end

    -- Объекты которые ИЗМЕНИЛИСЬ (цвет / размер / вращение)
    for path, cur in pairs(curSnap) do
        local ref = refSnap[path]
        if ref and cur.Color then   -- BasePart присутствует в обоих
            local changed = false
            if cur.Color ~= ref.Color then changed = true end
            if not changed and cur.Size        and ref.Size        and not sizeEq(cur.Size, ref.Size)               then changed = true end
            if not changed and cur.Orientation and ref.Orientation and not rotEq(cur.Orientation, ref.Orientation)  then changed = true end
            if changed then
                local obj = objByPath(seg, path)
                if obj then table.insert(anomalies, obj) end
            end
        end
    end

    -- Объекты которые ПРОПАЛИ (есть в 000, нет в текущем)
    for path in pairs(refSnap) do
        if curSnap[path] == nil then
            missingCount += 1
        end
    end

    return anomalies, missingCount
end

-- ── Главный цикл ───────────────────────────────────────────────
local lastSeg      = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastScanTime < SCAN_INTERVAL then return end
    lastScanTime = now

    local seg = getNearestSeg()
    if not seg then
        segLabel.Text = "Сегмент: не найден"
        cntLabel.Text = "Аномалий: —"
        return
    end

    if lastSeg and lastSeg ~= seg then
        clearHighlights(lastSeg)
    end
    lastSeg = seg

    segLabel.Text = "Сегмент: " .. seg.Name

    -- Segment000 — эталон, не сканируем
    if seg == reference then
        clearHighlights(seg)
        cntLabel.Text       = "Аномалий: 0"
        cntLabel.TextColor3 = Color3.fromRGB(90, 215, 90)
        return
    end

    local anomalies, missingCount = scanSeg(seg)

    clearHighlights(seg)
    for _, obj in ipairs(anomalies) do
        addHighlight(obj)
    end

    local total = #anomalies + missingCount
    cntLabel.Text       = "Аномалий: " .. total
    cntLabel.TextColor3 = total > 0
        and Color3.fromRGB(255, 75, 75)
        or  Color3.fromRGB(90, 215, 90)
end)

print("[AnomalyDetector v5] Запущен.")

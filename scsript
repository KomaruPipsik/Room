local gui          = buildGui()
local segmentLabel = gui.Panel.SegmentLabel
local countLabel   = gui.Panel.CountLabel

-- ── Хелперы ─────────────────────────────────────────────────

-- Получить позицию сегмента (центр его PrimaryPart или первого парта)
local function getSegmentPosition(seg)
	if seg.PrimaryPart then
		return seg.PrimaryPart.Position
	end
	for _, v in ipairs(seg:GetDescendants()) do
		if v:IsA("BasePart") then
			return v.Position
		end
	end
	return Vector3.new(0, 0, 0)
end

-- Найти ближайший к игроку сегмент
local function getNearestSegment()
	local char     = player.Character
	if not char then return nil end
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not rootPart then return nil end

	local nearest, nearestDist = nil, math.huge
	for _, seg in ipairs(mapSegments:GetChildren()) do
		if seg:IsA("Model") then
			local dist = (rootPart.Position - getSegmentPosition(seg)).Magnitude
			if dist < nearestDist then
				nearest     = seg
				nearestDist = dist
			end
		end
	end
	return nearest
end

-- Собрать плоский список имён дочерних объектов папки (1 уровень)
local function childNameSet(parent)
	local set = {}
	for _, child in ipairs(parent:GetChildren()) do
		set[child.Name] = true
	end
	return set
end

-- Добавить / обновить Highlight на объект
local function highlightObject(obj)
	-- Highlight должен лежать внутри объекта (BasePart или Model)
	if not (obj:IsA("BasePart") or obj:IsA("Model")) then return end

	local existing = obj:FindFirstChildOfClass("Highlight")
	if existing then return end  -- уже подсвечен

	local h = Instance.new("Highlight")
	h.FillColor    = HIGHLIGHT_COLOR
	h.OutlineColor = HIGHLIGHT_COLOR
	h.FillTransparency    = 0.55
	h.OutlineTransparency = 0
	h.Adornee = obj
	h.Parent  = obj
end

-- Убрать все Highlight-и, созданные нами, в сегменте
local function clearHighlights(seg)
	for _, h in ipairs(seg:GetDescendants()) do
		if h:IsA("Highlight") then
			h:Destroy()
		end
	end
end

-- ── Сравнение сегментов ─────────────────────────────────────

--[[
	Логика сравнения:
	1. Для каждой известной папки (Debris, Lateral, Objects, References)
	   собираем имена детей в эталоне и сравниваем с текущим сегментом.
	2. Если имя объекта есть в ANOMALY_NAMES — аномалия.
	3. Если в PuddleSpawn / ShadowSpawn есть любые дети — аномалия.
	4. Если объект в текущем сегменте отсутствует в эталоне — аномалия.
	   (т.е. сегмент содержит «лишние» объекты).
--]]

local KNOWN_FOLDERS = { "Debris", "Lateral", "Objects", "References" }

local function compareFolders(refFolder, curFolder, anomalies)
	if not refFolder or not curFolder then return end

	local refNames = childNameSet(refFolder)

	for _, child in ipairs(curFolder:GetChildren()) do
		-- Проверка по «чёрному списку» имён
		if ANOMALY_NAMES[child.Name] then
			table.insert(anomalies, child)

		-- Объект отсутствует в эталоне — лишний
		elseif not refNames[child.Name] then
			table.insert(anomalies, child)
		end
	end
end

local function checkSpawnFolders(curReferences, anomalies)
	if not curReferences then return end
	for _, folderName in ipairs(SPAWN_FOLDERS) do
		local folder = curReferences:FindFirstChild(folderName)
		if folder and #folder:GetChildren() > 0 then
			-- Подсвечиваем саму папку и каждого её ребёнка
			for _, child in ipairs(folder:GetChildren()) do
				table.insert(anomalies, child)
			end
		end
	end
end

local function scanSegment(seg)
	local anomalies = {}
	if seg == reference then return anomalies end  -- эталон не сканируем

	for _, folderName in ipairs(KNOWN_FOLDERS) do
		local refFolder = reference:FindFirstChild(folderName)
		local curFolder = seg:FindFirstChild(folderName)
		compareFolders(refFolder, curFolder, anomalies)
	end

	-- Отдельно — спавн-папки внутри References
	local curRef = seg:FindFirstChild("References")
	checkSpawnFolders(curRef, anomalies)

	return anomalies
end

-- ── Главный цикл ────────────────────────────────────────────

local lastSegment  = nil
local lastScanTime = 0

RunService.Heartbeat:Connect(function()
	local now = tick()
	if now - lastScanTime < SCAN_INTERVAL then return end
	lastScanTime = now

	local seg = getNearestSegment()
	if not seg then return end

	-- Если сменился сегмент — сбросить подсветку в старом
	if lastSegment and lastSegment ~= seg then
		clearHighlights(lastSegment)
	end
	lastSegment = seg

	-- Обновить GUI
	segmentLabel.Text = "Сегмент: " .. seg.Name

	-- Сканируем
	local anomalies = scanSegment(seg)

	-- Убираем старые хайлайты в текущем сегменте перед перерисовкой
	clearHighlights(seg)

	-- Применяем новые хайлайты
	for _, obj in ipairs(anomalies) do
		highlightObject(obj)
	end

	-- Обновляем счётчик
	local count = #anomalies
	if count > 0 then
		countLabel.Text      = "Аномалий: " .. count
		countLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
	else
		countLabel.Text       = "Аномалий: 0"
		countLabel.TextColor3 = Color3.fromRGB(100, 220, 100)
	end
end)

print("[AnomalyDetector] Скрипт запущен. Сканирование каждые", SCAN_INTERVAL, "сек.")

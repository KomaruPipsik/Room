local levelFolderName = "Level" -- Замени на реальное имя папки (посмотри в Dex)
local targetFolder = workspace:FindFirstChild(levelFolderName)

if not targetFolder then
    print("Папка уровня не найдена! Проверь имя в Explorer.")
    return
end

print("Сканер запущен. Ждем генерации коридора...")

targetFolder.DescendantAdded:Connect(function(descendant)
    -- Если в коридоре появляется новый объект (аномалия), подсвечиваем его
    task.wait(0.5) -- Ждем, пока объект прогрузится
    print("Внимание! Появился новый объект: " .. descendant.Name)
    
    if descendant:IsA("BasePart") then
        local h = Instance.new("Highlight")
        h.Parent = descendant
        h.FillColor = Color3.fromRGB(255, 0, 255) -- Розовый для теста
    end
end)

-- Проверка атрибутов (самый частый способ скрыть аномалию)
task.spawn(function()
    while task.wait(1) do
        local attrs = targetFolder:GetAttributes()
        for name, value in pairs(attrs) do
            print("Атрибут уровня: " .. name .. " = " .. tostring(value))
        end
    end
end)

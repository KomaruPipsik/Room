local HIGHLIGHT_COLOR = Color3.fromRGB(255, 40, 40)

-- Объекты, которые сами по себе являются аномалией
local ANOMALY_NAMES = {
	AnomalyDoor      = true,
	BubblegumSpawn   = true,
	Camouflage       = true,
	CarnisSpawn      = true,
	EletricPuddle    = true,
	Fog              = true,
	SCP096           = true,
	Stalker          = true,
	BloodPart        = true,
	Help             = true,
	WallDestroyEffect= true,
	ExtraCamera1     = true,
	ExtraCamera2     = true,
}

-- Папки в References, само наличие детей в которых — аномалия
local SPAWN_FOLDERS = { "PuddleSpawn", "ShadowSpawn" }

-- ── Ссылки на мир ───────────────────────────────────────────
local mapSegments = workspace:WaitForChild("MapSegments", 10)
if not mapSegments then
	warn("[AnomalyDetector] workspace.MapSegments не найден!")
	return
end

local reference = mapSegments:WaitForChild("Segment000", 10)
if not reference then
	warn("[AnomalyDetector] Segment000 не найден!")
